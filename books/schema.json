{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mirabilia Éditions — Fiche encyclopédique (série 365)",
  "description": "Schéma standard d'une entrée. Une entrée = une page = un jour. Vise un livre entier de 365 entrées.",
  "type": "object",
  "required": [
    "id", "day", "name_en", "name_la", "family",
    "origin", "parts_used", "harvest", "habitat",
    "active_compounds", "properties", "traditional_uses",
    "how_to_use", "precautions", "interactions",
    "cultural_note", "regions",
    "legend", "image_url"
  ],
  "properties": {
    "id":                { "type": "integer", "minimum": 1, "maximum": 365, "description": "Numéro de jour (1–365)." },
    "day":               { "type": "string", "pattern": "^(January|February|March|April|May|June|July|August|September|October|November|December) [0-9]{1,2}$", "description": "Date au format anglais. Ex : 'January 1'." },
    "name_en":           { "type": "string", "description": "Nom commun en anglais. Ex : 'Chamomile'." },
    "name_la":           { "type": "string", "description": "Nom latin scientifique. Ex : 'Matricaria chamomilla'." },
    "family":            { "type": "string", "description": "Famille botanique. Ex : 'Asteraceae'." },
    "origin":            { "type": "string", "maxLength": 220, "description": "Origine géographique en 1–2 phrases." },
    "parts_used":        { "type": "string", "maxLength": 220, "description": "Parties utilisées (fleurs, feuilles, racine…)." },
    "harvest":           { "type": "string", "maxLength": 220, "description": "Période et conditions de récolte." },
    "habitat":           { "type": "string", "maxLength": 220, "description": "Habitat naturel." },
    "active_compounds":  { "type": "string", "maxLength": 320, "description": "Composés actifs principaux." },
    "properties":        { "type": "string", "maxLength": 320, "description": "Propriétés médicinales." },
    "traditional_uses":  { "type": "string", "maxLength": 420, "description": "Usages traditionnels." },
    "how_to_use":        { "type": "string", "maxLength": 420, "description": "Mode d'utilisation (infusion, décoction, teinture, dosage indicatif)." },
    "precautions":       { "type": "string", "maxLength": 320, "description": "Précautions, contre-indications, toxicité." },
    "interactions":      { "type": "string", "maxLength": 320, "description": "Interactions médicamenteuses connues." },
    "cultural_note":     { "type": "string", "maxLength": 420, "description": "Note culturelle ou historique." },
    "regions":           { "type": "string", "maxLength": 220, "description": "Régions du monde où la plante est encore en usage." },
    "legend": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "description": "Légende de la planche botanique. Chaque item = [label, description]. Toujours en anglais. Abréviations : 'long. section', 'cross-section'.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string" }
      }
    },
    "image_url":         { "type": "string", "format": "uri", "description": "URL Wikimedia Commons de la planche (Köhler de préférence)." },
    "image_source":      { "type": "string", "description": "Source de l'illustration. Défaut : 'Köhler’s Medizinal-Pflanzen, 1887'." }
  },
  "additionalProperties": false
}
