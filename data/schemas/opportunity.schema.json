{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hugokeirsse-byte/365days/blob/main/data/schemas/opportunity.schema.json",
  "title": "Opportunity",
  "description": "Contrat canonique entre les modules de détection (M2, T) et les modules de production (A-W). Voir AUTOMATION_BLUEPRINT.md §9.",
  "type": "object",
  "required": ["id", "type", "niche", "score", "evidence", "next_action", "deadline"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^opp_\\d{4}-\\d{2}-\\d{2}_[a-z0-9_]+$",
      "description": "ID unique : opp_YYYY-MM-DD_slug_niche",
      "examples": ["opp_2026-05-19_mystical_mushrooms"]
    },
    "type": {
      "type": "string",
      "enum": [
        "kdp_coloring",
        "kdp_low_content",
        "kdp_fiction",
        "kdp_collector",
        "merch_design",
        "merch_collection",
        "mobile_game",
        "card_deck_pod",
        "stl_3d",
        "api_service",
        "video_faceless",
        "ar_filter",
        "audio_pack",
        "progeny_pack",
        "vintage_restoration",
        "domain_public_coloring",
        "domain_public_poster_set"
      ]
    },
    "niche": {
      "type": "string",
      "description": "Nom court de la niche (humanisé)",
      "examples": ["mystical mushrooms", "bébé super-héros golden age", "Köhler medicinal plants"]
    },
    "brand_id": {
      "type": "string",
      "enum": ["heritage_coloring", "iconic_offspring", "pocket_decks", "modern_cozy"],
      "description": "Brand cible (cf. brands_par_pilier.json)"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Score normalisé /100 (cf. scoring_matrix.json)"
    },
    "score_breakdown": {
      "type": "object",
      "properties": {
        "demande": { "type": "integer", "minimum": 0, "maximum": 4 },
        "concurrence_inversee": { "type": "integer", "minimum": 0, "maximum": 4 },
        "marge_par_unite": { "type": "integer", "minimum": 0, "maximum": 4 },
        "legalite": { "type": "integer", "minimum": 0, "maximum": 4 },
        "effort_production": { "type": "integer", "minimum": 0, "maximum": 4 },
        "levier_cross_canal": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Preuves chiffrées qui justifient le score",
      "properties": {
        "search_volume_monthly": { "type": "integer" },
        "competition_density": { "type": "string", "enum": ["low", "medium", "high", "saturated"] },
        "bestseller_review_pain_points": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Liste des défauts récurrents identifiés dans les reviews 1-3★ des bestsellers"
        },
        "trending_platform": { "type": "string", "description": "Plateforme où la tendance émerge" },
        "trending_hashtags": { "type": "array", "items": { "type": "string" } },
        "domain_public_source": { "type": "string", "description": "ID dans whitelist_pd.json si applicable" },
        "estimated_unit_margin_eur": { "type": "number" }
      }
    },
    "winning_formula_ref": {
      "type": "string",
      "description": "Path vers data/winning_formula/<niche>.json si déjà synthétisée"
    },
    "next_action": {
      "type": "string",
      "description": "Pipeline à déclencher",
      "examples": ["produce_coloring_book", "produce_progeny_pack", "produce_merch_batch"]
    },
    "cross_pollination_targets": {
      "type": "array",
      "description": "Liste des autres pipelines à déclencher en parallèle (matrice cross-canal)",
      "items": { "type": "string" }
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Date limite après laquelle l'opportunité expire si non exploitée"
    },
    "status": {
      "type": "string",
      "enum": ["new", "in_production", "in_staging", "published", "expired", "rejected"],
      "default": "new"
    },
    "created_by_module": { "type": "string", "examples": ["M2_sourcing", "agent_trend_explosion"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
